POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15433
POSTGRES_DB=vibedebate
POSTGRES_USER=vibedebate
POSTGRES_PASSWORD=vibedebate-local
KEYCLOAK_ISSUER=http://localhost:8180/realms/vibedebate
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/vibedebate/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=vibedebate-api
KEYCLOAK_CLIENT_ID=vibedebate-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-change-me

KEYCLOAK_ADMIN_API_URL=http://localhost:8180/admin/realms/vibedebate
KEYCLOAK_ADMIN_TOKEN_URL=http://localhost:8180/realms/vibedebate/protocol/openid-connect/token
KEYCLOAK_SERVICE_CLIENT_ID=vibedebate-backend
KEYCLOAK_SERVICE_CLIENT_SECRET=replace-with-service-client-secret

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_CONTEXT_CHARS=60000
DEFENSE_CHAT_COUNT=3

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
CACHE_ENABLED=true
CACHE_NAMESPACE=vibedebate:v1
CACHE_TIMEOUT_SECONDS=0.3
CACHE_CATALOG_TTL=900
CACHE_VIEW_TTL=60
CACHE_HISTORY_TTL=300
CACHE_ANALYSIS_TTL=3600
CACHE_STATUS_TTL=2
CACHE_MAX_ENTRY_BYTES=2000000

# Browser configuration; only VITE_* variables are exposed to the frontend.
VITE_API_BASE_URL=/api/v1
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=vibedebate
VITE_KEYCLOAK_CLIENT_ID=vibedebate-web
VITE_DEV_SERVER_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:8000

AI_RETRY_COUNT=2
AI_RETRY_BASE_DELAY_SECONDS=0.5
AI_RETRY_MAX_DELAY_SECONDS=8
API_PROXY_READ_TIMEOUT=600s
