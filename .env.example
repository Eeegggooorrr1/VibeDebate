POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15433
POSTGRES_DB=vibedebate
POSTGRES_USER=vibedebate
POSTGRES_PASSWORD=vibedebate-local
KEYCLOAK_ISSUER=http://localhost:8180/realms/vibedebate
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/vibedebate/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=vibedebate-api
KEYCLOAK_CLIENT_ID=vibedebate-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-change-me

KEYCLOAK_ADMIN_API_URL=http://localhost:8180/admin/realms/vibedebate
KEYCLOAK_ADMIN_TOKEN_URL=http://localhost:8180/realms/vibedebate/protocol/openid-connect/token
KEYCLOAK_SERVICE_CLIENT_ID=vibedebate-backend
KEYCLOAK_SERVICE_CLIENT_SECRET=replace-with-service-client-secret

# AI: the API starts without a key; generation then returns ai_not_configured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_CONTEXT_CHARS=60000
DEFENSE_CHAT_COUNT=3
